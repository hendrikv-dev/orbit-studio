# Dependencies
node_modules/

# Build and test output
dist/
coverage/
.vite/
*.tsbuildinfo

# Environment and local secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
# Local dev-server configuration for the preview tool, not project policy.
.claude/launch.json
# Wrangler's local state and R2 cache, written when publishing the archive.
.wrangler/
*.swp
*.swo

# Generated review and manual evidence (may contain externally acquired material)
/evidence/
/screenshots/
playwright-report/
test-results/
/review/
/review*.zip
/release-artifacts/
/.orbit-review.lock/
tmp/
temp/
.cache/

# Historical source acquisition cache
data/historical-catalog/raw/**
!data/historical-catalog/raw/.gitkeep
data/historical-catalog/cache/**

# Local-only/generated third-party data and assets
data/generated/**
data/local-only/**
public/earth/*.jpg
!public/earth/nasa-blue-marble-january-5400.jpg

# The VIIRS light-pollution archive: ~46 MB of derived numeric data, delivered
# from R2 rather than the static bundle. The sparse index beside it is tracked,
# and scripts/build-light-pollution-tiles.py rebuilds the archive from the
# source recorded in provenance/inventory.json.
public/tracker/*.bin

.orbit-studio-backups/
